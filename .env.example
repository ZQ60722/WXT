# ===== 复制本文件为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会上传）=====

# 硅基流动 API Key（在 https://cloud.siliconflow.cn 获取，用于 AI 评估/对话路由）
SILICONFLOW_API_KEY=sk-your-real-key-here

# 数据库连接串
# - 本地开发：留空即可，后端自动用 backend/db/lychee_culture.db (SQLite)
# - 上线：填写托管数据库的连接串，例如 Supabase 的：
#   postgresql://postgres:<密码>@db.<项目ID>.supabase.co:5432/postgres
DATABASE_URL=
